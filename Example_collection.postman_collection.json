    {
      "name": "Создание пользователя",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Генерим случайное число или метку времени\r",
              "const randomSuffix = Math.floor(Math.random() * 1000000);\r",
              "// Формируем email\r",
              "const randomEmail = `user${randomSuffix}@example.com`;\r",
              "\r",
              "// Сохраняем в переменную окружения (или collection)\r",
              "pm.collectionVariables.set('randomEmail', randomEmail);\r",
              "\r",
              "// Для отладки: выводим в консоль\r",
              "console.log('Generated email:', randomEmail);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Парсим JSON-ответ\r",
              "const userData = pm.response.json();\r",
              "\r",
              "// 2. Сохраняем значение id в переменную коллекции UserID\r",
              "pm.collectionVariables.set(\"UserID\", userData.id);\r",
              "\r",
              "// 3. Для подстраховки — проверим, что переменная записалась правильно\r",
              "pm.test(\"UserID сохранён в коллекции\", function () {\r",
              "    pm.expect(pm.collectionVariables.get(\"UserID\")).to.eql(userData.id);\r",
              "});\r",
              "\r",
              "pm.test(\"Тест на код ответа 200\", function () {\r",
              "    // 1. Читаем код ответа\r",
              "    const responseCode = pm.response.code;\r",
              "    \r",
              "    // 2. Проверяем и логируем\r",
              "    if (responseCode === 200) {\r",
              "        console.log(`✅ Тест пройден, код ответа: ${responseCode}`);\r",
              "        // Ни одной ошибки не кидаем – pm.test пометит тест как passed\r",
              "    } else {\r",
              "        console.log(`❌ Получен неожиданный код ответа: ${responseCode}`);\r",
              "        // Здесь явно фейлим тест с нужным текстом\r",
              "        pm.expect.fail(`Получен неожиданный код ответа: ${responseCode}`);\r",
              "    }\r",
              "});\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
